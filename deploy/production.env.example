# Server-side environment for contact_page_automation/backend.
# Copy to backend/.env on the server and replace the sample credentials.
NODE_ENV=production
PORT=5173
FRONTEND_ORIGIN=http://leadfill.zeacrm.com
APP_BASE_URL=http://leadfill.zeacrm.com
API_AUTH_TOKEN=replace-with-a-long-random-server-secret
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb

CAPTCHA_PROVIDER=capsolver
CAPTCHA_SOLVING_ENABLED=true
CAPSOLVER_API_KEY=replace-with-your-capsolver-dashboard-api-key
CAPSOLVER_TIMEOUT_MS=180000
CAPTCHA_MANUAL_ENTRY_TIMEOUT_SECONDS=0

PUPPETEER_HEADLESS=true
AUTOMATION_DRY_RUN=true
AUTOMATION_BATCH_SIZE=10
SUBMIT_CONFIRMATION_TIMEOUT_SECONDS=90
MATH_CAPTCHA_ENABLED=true

# Google service account: both email and private key must be configured together.
GOOGLE_SHEET_ID=replace-with-your-sheet-id
GOOGLE_SHEET_TAB=Websites
GOOGLE_SERVICE_ACCOUNT_EMAIL=automation@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-key\n-----END PRIVATE KEY-----\n"

# Optional form-assistance model. Uncomment and set a real key if using Claude.
# ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_TIMEOUT_MS=20000
CLAUDE_MAX_RETRIES=1

# No OHMYCAPTCHA_URL, CLIENT_KEY, Python service, or localhost:8000 is needed.
