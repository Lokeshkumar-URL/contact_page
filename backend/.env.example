PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
API_AUTH_TOKEN=
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
# Google values below are only a FALLBACK. Users pick their sheet, tab and Google account in the UI (Settings).
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Websites
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_TIMEOUT_MS=20000
CLAUDE_MAX_RETRIES=1
AUTOMATION_BATCH_SIZE=10
AUTOMATION_DRY_RUN=true
PUPPETEER_HEADLESS=false

# FastCaptcha (fastcaptcha.org) image-CAPTCHA solving. Empty = CAPTCHA forms go to manual review.
FASTCAPTCHA_API_KEY=
FASTCAPTCHA_TIMEOUT_MS=20000
# Visible-browser runs only: seconds to wait for a person to type the CAPTCHA if FastCaptcha fails (0 = off).
CAPTCHA_MANUAL_ENTRY_TIMEOUT_SECONDS=90
# How long to wait for a "thank you"/confirmation after clicking Submit (10-300 seconds).
SUBMIT_CONFIRMATION_TIMEOUT_SECONDS=90
# Answer simple math CAPTCHAs ("What is 3 + 4?") automatically. Set false where not authorised.
MATH_CAPTCHA_ENABLED=true

# Self-hosted OhMyCaptcha (preferred over FastCaptcha when URL is set).
CAPTCHA_SOLVING_ENABLED=false
OHMYCAPTCHA_URL=http://127.0.0.1:8000
OHMYCAPTCHA_CLIENT_KEY=
OHMYCAPTCHA_TIMEOUT_MS=120000

# CapSolver: choose capsolver to use the hosted API instead of the local Python service.
CAPTCHA_PROVIDER=capsolver
CAPSOLVER_API_KEY=
CAPSOLVER_TIMEOUT_MS=180000

# --- Accounts & invitations ---
# Public URL of the frontend; used to build invitation links in emails.
APP_BASE_URL=http://localhost:5173
# Optional: fixed secret (32+ chars) for signing sessions. Empty = generated and stored in backend/storage/users.json.
SESSION_SECRET=
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=72
# SMTP used to email invitations. If SMTP_HOST is empty the admin UI shows the invite link to copy instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FormPilot <no-reply@example.com>
